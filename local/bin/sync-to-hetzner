#!/bin/bash

# Script to sync music collection to Hetzner Navidrome server
# One-off sync for initial migration from local Navidrome to Hetzner

set -e  # Exit on error

# Get script directory for includes file
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INCLUDES_FILE="$SCRIPT_DIR/rsync-music-includes.txt"

SOURCE="/Volumes/c2storage/DJ/collection2/"
SOURCE_SOURCING="/Volumes/c2storage/DJ/sourcing/"
DEST="root@37.27.252.86:/mnt/music/collection2/"
DEST_SOURCING="root@37.27.252.86:/mnt/music/sourcing/"
HETZNER_HOST="root@37.27.252.86"

# Check if source exists
if [ ! -d "$SOURCE" ]; then
    echo "Error: Source directory not found at $SOURCE"
    exit 1
fi

# Check if sourcing directory exists
if [ ! -d "$SOURCE_SOURCING" ]; then
    echo "Error: Sourcing directory not found at $SOURCE_SOURCING"
    exit 1
fi

# Display what will be synced
echo "=== RSYNC Music to Hetzner ==="
echo "Collection Source: $SOURCE"
echo "Collection Destination: $DEST"
echo "Sourcing Source: $SOURCE_SOURCING"
echo "Sourcing Destination: $DEST_SOURCING"
echo ""
echo "Using inclusion-based sync (music files only)..."
echo ""

# Parse flags
DRY_RUN=""
FULL_SCAN=false
for arg in "$@"; do
    case "$arg" in
        --dry-run|-n) DRY_RUN="--dry-run" ;;
        --full-scan) FULL_SCAN=true ;;
    esac
done

if [ -n "$DRY_RUN" ]; then
    echo "*** DRY RUN MODE - No files will be copied ***"
    echo ""
fi

# Run rsync for collection
echo "Syncing collection..."
echo ""

rsync -avO \
    --progress \
    --delete-after \
    --backup \
    --backup-dir=/mnt/music/.rsync-backup \
    --chown=navidrome:navidrome \
    --exclude='._*' \
    --exclude='.DS_Store' \
    --exclude='.*' \
    --exclude='playlists/' \
    --include-from="$INCLUDES_FILE" \
    --exclude='*' \
    $DRY_RUN \
    "$SOURCE" "$DEST"

echo ""
echo "=== Syncing Sourcing Directory ==="
echo ""

# Sync the actual sourcing directory
# -O (--omit-dir-times) ensures directories get current mtime so Navidrome rescans
rsync -avO \
    --progress \
    --delete-after \
    --backup \
    --backup-dir=/mnt/music/.rsync-backup \
    --chown=navidrome:navidrome \
    --exclude='._*' \
    --exclude='.DS_Store' \
    --exclude='.*' \
    --include-from="$INCLUDES_FILE" \
    --exclude='*' \
    $DRY_RUN \
    "$SOURCE_SOURCING" "$DEST_SOURCING"

echo ""
echo "=== Transforming playlist paths for Hetzner ==="
echo ""

# Create temporary directory for transformed playlists
TEMP_DIR=$(mktemp -d)
PLAYLIST_DIR="$SOURCE/playlists"

if [ -d "$PLAYLIST_DIR" ]; then
    echo "Processing playlists..."

    # Find all m3u8 files and transform them
    find "$PLAYLIST_DIR" -name "*.m3u8" | while read -r playlist; do
        relative_path="${playlist#$PLAYLIST_DIR/}"
        temp_playlist="$TEMP_DIR/$relative_path"

        # Create subdirectories in temp if needed
        mkdir -p "$(dirname "$temp_playlist")"

        # Transform local paths to Hetzner paths
        # Use LC_ALL=C to handle special characters in file paths
        LC_ALL=C sed \
            -e 's|/Volumes/c2storage/DJ/collection2/sourcing|/mnt/music/sourcing|g' \
            -e 's|/Volumes/c2storage/DJ/collection2|/mnt/music/collection2|g' \
            -e 's|/Volumes/c2storage/DJ/sourcing|/mnt/music/sourcing|g' \
            -e 's|/Volumes/c2storage/Production/Exports|/mnt/music/exports|g' \
            "$playlist" > "$temp_playlist"

        echo "  Transformed: $(basename "$playlist")"
    done

    echo ""
    echo "Syncing transformed playlists to Hetzner..."
    echo ""

    # Sync the transformed playlists to Hetzner
    rsync -av \
        --progress \
        --chown=navidrome:navidrome \
        $DRY_RUN \
        "$TEMP_DIR/" "root@37.27.252.86:/mnt/music/collection2/playlists/"

    # Cleanup
    rm -rf "$TEMP_DIR"
    echo ""
    echo "Playlists transformed and synced!"
else
    echo "No playlists directory found at $PLAYLIST_DIR"
fi

echo ""
echo "=== Rebuilding sourcing playlist on Hetzner ==="
echo ""

if [ -z "$DRY_RUN" ]; then
    ssh "$HETZNER_HOST" bash <<'ENDSSH'
        cd /mnt/music/sourcing
        {
            echo "#EXTM3U"
            find . -type f \( -iname "*.mp3" -o -iname "*.aiff" -o -iname "*.aif" -o -iname "*.wav" -o -iname "*.flac" -o -iname "*.m4a" \) -size +0 \
                -printf "%f\n" | sort | while read filename; do
                    echo "/mnt/music/sourcing/$filename"
                done
        } > /mnt/music/collection2/playlists/sourcing.m3u8
        chown navidrome:navidrome /mnt/music/collection2/playlists/sourcing.m3u8
        COUNT=$(grep -c -v '^#' /mnt/music/collection2/playlists/sourcing.m3u8 || true)
        echo "sourcing.m3u8: $COUNT track(s)"
ENDSSH
else
    echo "[DRY RUN] Would rebuild sourcing.m3u8"
fi

echo ""
echo "=== Fixing Permissions on Hetzner ==="
echo ""

# Fix ownership for Navidrome
if [ -z "$DRY_RUN" ]; then
    ssh "$HETZNER_HOST" "chown -R navidrome:navidrome /mnt/music/collection2 /mnt/music/sourcing /mnt/music/exports"
    echo "Ownership updated to navidrome:navidrome"
else
    echo "[DRY RUN] Would set ownership to navidrome:navidrome"
fi

echo ""
echo "=== Deploying Navidrome Config ==="
echo ""

if [ -z "$DRY_RUN" ]; then
    scp "$SCRIPT_DIR/../../hetzner/navidrome.toml" "$HETZNER_HOST:/var/lib/navidrome/navidrome.toml"
    ssh "$HETZNER_HOST" "chown navidrome:navidrome /var/lib/navidrome/navidrome.toml"
    echo "Config deployed"
else
    echo "[DRY RUN] Would deploy navidrome.toml"
fi

echo ""
if [ "$FULL_SCAN" = true ]; then
    echo "=== Running Full Scan ==="
    echo ""
    if [ -z "$DRY_RUN" ]; then
        ssh "$HETZNER_HOST" bash <<'ENDSSH'
            systemctl stop navidrome
            sudo -u navidrome /opt/navidrome/navidrome scan --full --configfile /var/lib/navidrome/navidrome.toml 2>&1 || echo "Warning: scan returned non-zero exit code"
            systemctl start navidrome
ENDSSH
        echo "Full scan completed - Navidrome restarted"
    else
        echo "[DRY RUN] Would stop navidrome, run full scan, and restart"
    fi
else
    echo "=== Restarting Navidrome ==="
    echo ""
    if [ -z "$DRY_RUN" ]; then
        ssh "$HETZNER_HOST" "systemctl restart navidrome"
        echo "Navidrome restarted - incremental scan will run on schedule"
    else
        echo "[DRY RUN] Would restart navidrome"
    fi
fi

echo ""
echo "=== Cleaning Up Old Backups ==="
echo ""

if [ -z "$DRY_RUN" ]; then
    ssh "$HETZNER_HOST" "find /mnt/music/.rsync-backup -mtime +30 -delete 2>/dev/null; find /var/lib/navidrome -name 'navidrome.db.backup-*' -mtime +30 -delete 2>/dev/null" || true
    echo "Removed backups older than 30 days"
fi

echo ""
echo "=== Sync Complete ==="
